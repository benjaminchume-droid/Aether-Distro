# Aether x86_64 kernel baseline
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_VT=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
